# =============================================================================
# Systemize Boilerplate — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values. Never commit real credentials.
# See src/lib/env/ for validation schemas.
# =============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: service-role key for admin operations (rare, audited)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SYSTEMIZE PORTAL authentication (server-only) ---
# The only internal owner account for the MVP. Google OAuth itself is configured
# in the Supabase dashboard; its client secret never belongs in this repository.
SYSTEMIZE_OWNER_GMAIL=owner@gmail.com

# --- PWA Web Push ---
# Generate one stable pair with: npx web-push generate-vapid-keys
# The public key is safe for browsers. The private key and cron secret are server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@systemize.co.il
CRON_SECRET=

# --- Supabase CLI: local Google OAuth ---
# Copy this key to a root `.env` file (not `.env.local`). The Supabase CLI reads
# root `.env` when resolving `env(...)` values from supabase/config.toml.
# Never commit or share the real secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# --- Telegram lead notifications (server-only) ---
# Notification-only and best-effort: a failed send never affects a stored lead.
# Leave BOTH empty in development and the console notification provider stays the
# active path. Setting both selects the real Telegram adapter. A production build
# with neither set fails loudly at first use rather than dropping notifications.
#   TELEGRAM_BOT_TOKEN — from @BotFather, of the form <bot_id>:<secret>
#   TELEGRAM_CHAT_ID   — the owner's chat or channel id the bot posts to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (Optional) ---
# Provider-neutral: configure when a real provider is chosen
# OBSERVABILITY_DSN=
# OBSERVABILITY_ENVIRONMENT=development
