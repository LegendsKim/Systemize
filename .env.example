# =============================================================================
# Systemize Boilerplate — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values. Never commit real credentials.
# See src/lib/env/ for validation schemas.
# =============================================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: service-role key for admin operations (rare, audited)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Observability (Optional) ---
# Provider-neutral: configure when a real provider is chosen
# OBSERVABILITY_DSN=
# OBSERVABILITY_ENVIRONMENT=development
