{
  "name": "systemize-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "description": "SYSTEMIZE marketing site and authenticated client delivery portal. Hebrew, RTL, Next.js App Router with Supabase.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:portal": "node scripts/run-portal-e2e.mjs",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual --project=visual-mobile --project=visual-rtl",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "brand:og": "node scripts/generate-open-graph-image.mjs",
    "pwa:keys": "web-push generate-vapid-keys --json",
    "test:db": "supabase db reset && supabase test db",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:vercel-config": "config compile",
    "check:dependencies": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:architecture && npm run check:vercel-config && npm run check:dependencies"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/config": "^0.5.5",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "path-to-regexp": "6.3.0"
  }
}
